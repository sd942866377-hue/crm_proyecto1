# Reporte de Calidad (cliente-misterioso) — artefactos locales
test/eval/last-run.json
reporte-calidad.html

# Backups de prompt de miembros (locales, NO van al template → a todos los bots)
member/prompt-backup-*.txt

# Backups de settings en vivo (contienen llm_api_key / owner_session) — NUNCA commitear
member/backup-settings-*.json

# KB y migraciones de cada miembro (locales, específicos de SU bot → NO al template)
member/kb/*
!member/kb/.gitkeep
member/migracion-*/
